<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.VisionRead" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">#548AF6</item>
        <item name="android:windowBackground">#558DFD</item>
        <item name="android:statusBarColor">#5A8FFA</item>
        <item name="android:navigationBarColor">#5990FD</item>
        <item name="android:textColorPrimary">@color/text</item>
    </style>

    <style name="ArrowCell">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:background">@drawable/arrow_cell_normal</item>
        <item name="android:alpha">0.4</item>
        <item name="android:layout_margin">3dp</item>
    </style>

</resources>
